{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hopeless-t.github.io/chatgpt-recovery-dynamics/repository-observatory/meta-improvement-event.schema.json",
  "title": "Meta Improvement Loop Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meta_cycle_id",
    "seq",
    "record_type",
    "wall_time_utc",
    "source_commit",
    "evidence_class",
    "details"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "meta_cycle_id": {
      "type": "string",
      "pattern": "^MIL-[0-9]{3,}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "record_type": {
      "type": "string",
      "enum": [
        "meta_cycle_start",
        "meta_observation",
        "meta_change",
        "meta_verification",
        "meta_promotion",
        "meta_cycle_end"
      ]
    },
    "wall_time_utc": {
      "type": "string",
      "format": "date-time"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "design",
        "observed",
        "recomputed",
        "change",
        "verified"
      ]
    },
    "details": {
      "type": "object"
    }
  }
}
